[Unit]
Description=Logind lock event to systemd target translation
Documentation=https://github.com/Infiniti151/systemd-lock-handler
BindsTo=graphical-session.target
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Slice=session.slice
Environment="FLAGS="
EnvironmentFile=-%h/.config/systemd-lock-handler.conf
ExecStart={{BIN_PATH}} $FLAGS
Type=notify
Restart=always
RestartSec=3s

[Install]
WantedBy=graphical-session.target